{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "LogProcessor": {
    "BufferPath": "C:/logstash-buffer",
    "ArchivePath": "C:/logstash-buffer/archive",
    "ArchiveRetentionDays": 2,
    "ErrorPath": "C:/logstash-buffer/error",
    "FilePattern": "*.jsonl",
    "ConnectionString": "Server=SWAPNALI\\SQLEXPRESS;Database=LogstashDB;User ID=logstash_user;Password=Logstash@123;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;",
    //"ConnectionString": "Server=K-PC\\SQLEXPRESS;Database=ClearPulseDb;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=False",
    "BatchSize": 10000,
    "PollDelaySeconds": 30,
    "Bulk": {
      "BatchSize": 5000,
      "TimeoutSeconds": 600,
      "UseTableLock": true,
      "Retries": 3,
      "RetryDelaySeconds": 2
    }
  }
}
