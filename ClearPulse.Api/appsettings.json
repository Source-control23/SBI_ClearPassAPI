{
  "ConnectionStrings": {
    //"ClearPulseDb": "Server=K-PC\\SQLEXPRESS;Database=ClearPulseDb;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=False",
    "ClearPulseDb": "Server=SWAPNALI\\SQLEXPRESS;Database=LogstashDB;User ID=logstash_user;Password=Logstash@123;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"
  },

  "Auth": {
    // Set to true to allow local user authentication (bypasses AD)
    "AllowLocalAuth": true,

    // Set to true to enable AD/Azure AD integration
    "EnableADIntegration": false,

    // Set to true to seed a default admin user on startup
    "SeedDefaultAdmin": true,

    // Azure AD / ADFS Configuration (when EnableADIntegration = true)
    "Authority": "https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0",
    "Audience": "api://YOUR_APP_ID",

    // Optional: For ADFS instead of Azure AD
    // "Authority": "https://adfs.yourdomain.com/adfs",
    // "MetadataAddress": "https://adfs.yourdomain.com/adfs/.well-known/openid-configuration",

    // Local JWT Configuration (when using local users)
    "Local": {
      // IMPORTANT: Change this to a secure random key in production!
      // Generate with: openssl rand -base64 32
      "SigningKey": "ThisIsAVerySecureSecretKeyPleaseChangeInProduction1234567890",
      "Issuer": "ClearPulseLocal",
      "ExpiryMinutes": 480
    },

    "Audience1": "ClearPulseApi"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "AllowedHosts": "*",

  // Dashboard Configuration
  "Dashboard": {
    "DefaultTake": 500,
    "MaxTake": 2000,
    "HistoricalDaysLimit": 90,
    "ExportMaxRecords": 50000
  }
}